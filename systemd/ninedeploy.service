# NineDeploy systemd service template — rendered by install.sh with this
# install's paths and written to /etc/systemd/system/ninedeploy.service.
# Placeholders (filled by install.sh): @NODE@ @INSTALL_DIR@ @DATA_DIR@
# @USER@ @GROUP@
#
# Manual use (adjust the placeholders yourself):
#   sudo cp systemd/ninedeploy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ninedeploy
#
[Unit]
Description=NineDeploy — Self-hosted PaaS
Documentation=https://github.com/ninedeploy/ninedeploy
After=network.target docker.service
Requires=docker.service

[Service]
User=@USER@
Group=@GROUP@
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=@INSTALL_DIR@/.env
ExecStart=@NODE@ @INSTALL_DIR@/apps/server/dist/server.js
Restart=always
RestartSec=5

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=@DATA_DIR@
PrivateTmp=true

# Watchdog: the server pings systemd every 30s (sd_notify); a hung process is
# restarted automatically. Requires Type=notify support via NOTIFY_SOCKET,
# which systemd sets for Type=notify services.
Type=notify
WatchdogSec=90

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ninedeploy

[Install]
WantedBy=multi-user.target
