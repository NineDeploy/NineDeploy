# NineDeploy systemd service template — rendered by install.sh with this
# install's paths and written to /etc/systemd/system/ninedeploy.service.
# Placeholders (filled by install.sh): @NODE@ @INSTALL_DIR@ @DATA_DIR@
# @USER@ @GROUP@
#
# Manual use (adjust the placeholders yourself):
#   sudo cp systemd/ninedeploy.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ninedeploy
#
[Unit]
Description=NineDeploy — Self-hosted PaaS
Documentation=https://github.com/ninedeploy/ninedeploy
After=network.target docker.service
Requires=docker.service

[Service]
User=@USER@
Group=@GROUP@
SupplementaryGroups=docker
WorkingDirectory=@INSTALL_DIR@
EnvironmentFile=@INSTALL_DIR@/.env
ExecStart=@NODE@ @INSTALL_DIR@/apps/server/dist/server.js
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Hardening & Permissions
NoNewPrivileges=true
ProtectSystem=full
ReadWritePaths=@INSTALL_DIR@ @DATA_DIR@ /tmp -/var/run/docker.sock -/run/docker.sock
PrivateTmp=true

# Deployments routinely run longer than watchdog windows while Docker unpacks
# large images. Keep readiness under the installer's HTTP health gate and
# explicitly disable watchdog supervision so upgrades also neutralize stale
# Type=notify/WatchdogSec installations.
Type=simple
WatchdogSec=0

# Logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ninedeploy

[Install]
WantedBy=multi-user.target
