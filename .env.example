# ── NineDeploy environment ────────────────────────────────────────────
# Copy to .env and adjust. Never commit .env.

# Runtime: "development" | "production"
NODE_ENV=development

# Where NineDeploy stores its data (db, repos, logs, backups).
NINEDEPLOY_DATA_DIR=./.data

# SQLite database file (relative to data dir unless absolute).
NINEDEPLOY_DB_PATH=./.data/ninedeploy.db

# Server
NINEDEPLOY_HOST=0.0.0.0
NINEDEPLOY_PORT=3000

# Public URL the dashboard is reached at (used for webhooks, CORS, emails).
NINEDEPLOY_PUBLIC_URL=http://localhost:3000

# Auth — JWT signing secrets (generate long random strings in production).
NINEDEPLOY_JWT_SECRET=change-me-to-a-long-random-string
NINEDEPLOY_JWT_ACCESS_TTL=15m
NINEDEPLOY_JWT_REFRESH_TTL=7d

# Master key for encrypting secrets at rest (AES-256-GCM).
# Leave empty on first run to auto-generate /etc/nodedeploy... or DATA_DIR/master.key.
NINEDEPLOY_MASTER_KEY=
